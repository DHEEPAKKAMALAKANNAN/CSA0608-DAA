{
  "task": "Task 4 - Minimum spanning tree of the city fibre backbone (Prim and Kruskal)",
  "id_scheme": "G = given in the task statement, S = student-designed, B = boundary, F = failure / invalid input",
  "cases": [
    {"id": "T4-G1", "category": "given", "type": "mst_file", "file": "given_G1_fibre_network.csv",
     "description": "9 sites, 14 candidate routes", "expect": {"weight": 37, "edges": 8, "distinct_msts": 2}},
    {"id": "T4-S1", "category": "student", "type": "random_vs_bruteforce", "trials": 150, "n": 7, "m": 11, "seed": 41,
     "description": "Prim(heap) = Prim(array) = Kruskal = brute force", "expect": {"all_ok": true}},
    {"id": "T4-S2", "category": "student", "type": "uf_modes", "trials": 100, "n": 60, "m": 200, "seed": 42,
     "description": "naive / rank / rank+compress union-find give the same MST weight", "expect": {"all_ok": true}},
    {"id": "T4-S3", "category": "student", "type": "cut_property", "file": "given_G1_fibre_network.csv",
     "description": "every tree edge is a lightest edge across its cut", "expect": {"all_ok": true}},
    {"id": "T4-S4", "category": "student", "type": "random_large", "n": 3000, "m": 12000, "seed": 43,
     "description": "3,000 sites: Prim(heap) = Prim(array) = Kruskal", "expect": {"all_ok": true}},
    {"id": "T4-B1", "category": "boundary", "type": "mst", "n": 1, "edges": [],
     "description": "one site", "expect": {"weight": 0, "edges": 0}},
    {"id": "T4-B2", "category": "boundary", "type": "mst", "n": 2, "edges": [[0,1,7]],
     "description": "two sites, one route", "expect": {"weight": 7, "edges": 1}},
    {"id": "T4-B3", "category": "boundary", "type": "mst", "n": 3, "edges": [[0,1,9],[0,1,4],[1,1,1],[1,2,5]],
     "description": "parallel routes and a self-loop", "expect": {"weight": 9, "edges": 2}},
    {"id": "T4-B4", "category": "boundary", "type": "mst", "n": 4, "edges": [[0,1,3],[0,2,3],[0,3,3],[1,2,3],[1,3,3],[2,3,3]],
     "description": "all weights equal", "expect": {"weight": 9, "edges": 3}},
    {"id": "T4-B5", "category": "boundary", "type": "mst", "n": 4, "edges": [[0,1,4],[1,2,-2],[2,3,6],[0,3,5],[0,2,3]],
     "description": "negative (subsidised) route", "expect": {"weight": 6, "edges": 3}},
    {"id": "T4-F1", "category": "failure", "type": "disconnected_file", "file": "failure_F1_disconnected.csv",
     "description": "two components: Prim partial, Kruskal forest, spanning_tree() refuses",
     "expect": {"prim_reached": 4, "forest_edges": 5, "components": 2, "forest_weight": 18, "error": "ValueError"}},
    {"id": "T4-F2", "category": "failure", "type": "mst", "n": 3, "edges": [[0,5,2]],
     "description": "route to an unknown site", "expect": {"error": "ValueError"}},
    {"id": "T4-F3", "category": "failure", "type": "mst", "n": 0, "edges": [],
     "description": "network without sites", "expect": {"error": "ValueError"}}
  ]
}
