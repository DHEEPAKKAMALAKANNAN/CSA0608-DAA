{"task": "Assembly Line Scheduling DP (two lines)",
 "cases": [
  {"id": "T4-N1", "type": "factory", "description": "factory instance: minimum 32, route L1 L1 L2 L2 L1 L1", "expect": {"time": 32, "lines": [1, 1, 2, 2, 1, 1]}},
  {"id": "T4-N2", "type": "transfers", "description": "transfer points after S2 (L1->L2) and after S4 (L2->L1)", "expect": [[2, 1, 2, 2], [4, 2, 1, 2]]},
  {"id": "T4-N3", "type": "trace", "description": "decision table: every f = min(stay, transfer) and choice matches", "expect": {"valid": true}},
  {"id": "T4-V1", "type": "random_vs_exhaustive", "trials": 400, "n_max": 9, "seed": 42, "description": "400 random instances: DP = exhaustive 2^n, route re-sums", "expect": {"all_ok": true}},
  {"id": "T4-V2", "type": "clrs", "description": "textbook instance (CLRS 15.1): minimum 38", "expect": {"time": 38, "lines": [1, 2, 1, 2, 2, 1]}},
  {"id": "T4-R1", "type": "change", "change": {"t1": {"2": 12}}, "description": "4.3: transfer after S2 -> 12: time 35, station-3 decision flips", "expect": {"time": 35, "lines": [1, 2, 2, 2, 1, 1]}},
  {"id": "T4-R2", "type": "change", "change": {"a2": {"4": 12}}, "description": "4.4: L2-S4 slowed to 12: time 38, S4 moves to line 1", "expect": {"time": 38, "lines": [1, 1, 2, 1, 1, 1]}},
  {"id": "T4-R3", "type": "monotone", "trials": 200, "seed": 43, "description": "raising any one time never lowers the optimum", "expect": {"all_ok": true}},
  {"id": "T4-B1", "type": "instance", "a1": [5], "a2": [3], "t1": [], "t2": [], "e": [2, 4], "x": [1, 3], "description": "single station: min(2+5+1, 4+3+3) = 8", "expect": {"time": 8, "lines": [1]}},
  {"id": "T4-B2", "type": "instance", "a1": [3, 3, 3], "a2": [3, 3, 3], "t1": [1, 1], "t2": [1, 1], "e": [1, 1], "x": [1, 1], "description": "identical lines: tie -> no transfer", "expect": {"time": 11, "lines": [1, 1, 1]}},
  {"id": "T4-B3", "type": "instance", "a1": [1, 9, 1], "a2": [9, 1, 9], "t1": [0, 0], "t2": [0, 0], "e": [0, 0], "x": [0, 0], "description": "zero transfer times: pick the faster station each time", "expect": {"time": 3, "lines": [1, 2, 1]}},
  {"id": "T4-F1", "type": "error", "a1": [1, 2, 3], "a2": [1, 2], "t1": [1, 1], "t2": [1], "e": [1, 1], "x": [1, 1], "description": "lines of different length rejected", "expect": {"error": "ValueError"}},
  {"id": "T4-F2", "type": "error", "a1": [1, -2], "a2": [1, 2], "t1": [1], "t2": [1], "e": [1, 1], "x": [1, 1], "description": "negative processing time rejected", "expect": {"error": "ValueError"}},
  {"id": "T4-F3", "type": "error", "a1": [], "a2": [], "t1": [], "t2": [], "e": [1, 1], "x": [1, 1], "description": "no stations rejected", "expect": {"error": "ValueError"}}
 ]}
