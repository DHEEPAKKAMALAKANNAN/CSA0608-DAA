{
  "task": "Task 1 - Activity selection for the EOC briefing room (half-open intervals [start, finish))",
  "id_scheme": "G = given in the task statement, S = student-designed, B = boundary, F = failure / invalid input",
  "cases": [
    {"id": "T1-G1", "category": "given", "type": "eft_file", "file": "given_G1_bookings.csv",
     "description": "11 requests of one day", "expect": {"count": 4, "selected": ["R2", "R5", "R10", "R7"]}},
    {"id": "T1-G2", "category": "given", "type": "eft_file", "file": "given_G2_back_to_back.csv",
     "description": "touching sessions are compatible", "expect": {"count": 3, "selected": ["P1", "P2", "P3"]}},
    {"id": "T1-S1", "category": "student", "type": "rule_fails", "rule": "earliest start",
     "description": "all-day exercise blocks earliest-start rule",
     "requests": [["C1","08:00","17:00"],["C2","09:00","10:00"],["C3","11:00","12:00"],["C4","13:00","14:00"]],
     "expect": {"rule_count": 1, "eft_count": 3, "optimum": 3}},
    {"id": "T1-S2", "category": "student", "type": "rule_fails", "rule": "shortest duration",
     "description": "short session straddling two long ones",
     "requests": [["S1","09:00","12:00"],["S2","12:00","15:00"],["S3","11:30","12:30"]],
     "expect": {"rule_count": 1, "eft_count": 2, "optimum": 2}},
    {"id": "T1-S3", "category": "student", "type": "rule_fails", "rule": "fewest conflicts",
     "description": "13-request trap for the fewest-conflicts rule",
     "requests": [["T1","08:00","10:00"],["T2","10:00","12:00"],["T3","12:00","14:00"],["T4","14:00","16:00"],
                  ["M1","09:30","10:30"],["M2","11:30","12:30"],["M3","13:30","14:30"],["X1","09:00","10:15"],
                  ["X2","09:15","10:30"],["X3","09:45","10:30"],["Y1","13:45","15:00"],["Y2","13:30","14:45"],
                  ["Y3","13:30","14:15"]],
     "expect": {"rule_count": 3, "eft_count": 4, "optimum": 4}},
    {"id": "T1-S4", "category": "student", "type": "random_vs_bruteforce", "trials": 500, "n": 12, "seed": 11,
     "description": "EFT = brute-force optimum on 500 random days", "expect": {"all_equal": true}},
    {"id": "T1-S5", "category": "student", "type": "random_naive_equal", "trials": 200, "n": 40, "seed": 12,
     "description": "naive re-scan EFT = sort-once EFT = DP on 200 random days", "expect": {"all_equal": true}},
    {"id": "T1-S6", "category": "student", "type": "rule_equals_eft", "rule": "latest start", "file": "given_G1_bookings.csv",
     "description": "mirror rule (latest start) is also optimal on G1", "expect": {"count": 4}},
    {"id": "T1-B1", "category": "boundary", "type": "eft", "requests": [],
     "description": "no requests", "expect": {"count": 0}},
    {"id": "T1-B2", "category": "boundary", "type": "eft", "requests": [["B1","09:00","10:00"]],
     "description": "a single request", "expect": {"count": 1}},
    {"id": "T1-B3", "category": "boundary", "type": "eft",
     "requests": [["I1","14:00","15:00"],["I2","14:00","15:00"],["I3","14:00","15:00"]],
     "description": "three identical requests", "expect": {"count": 1}},
    {"id": "T1-B4", "category": "boundary", "type": "eft",
     "requests": [["D1","08:00","09:00"],["D2","09:00","10:00"],["D3","10:30","11:00"],["D4","12:00","13:00"],["D5","16:00","17:00"]],
     "description": "all requests disjoint", "expect": {"count": 5}},
    {"id": "T1-B5", "category": "boundary", "type": "eft",
     "requests": [["L","08:00","18:00"],["a","09:00","10:00"],["b","10:00","11:00"],["c","13:00","14:00"],["d","15:00","16:00"]],
     "description": "all-day request with four requests inside", "expect": {"count": 4}},
    {"id": "T1-B6", "category": "boundary", "type": "eft",
     "requests": [["E1","10:00","12:00"],["E2","11:00","12:00"],["E3","09:00","12:00"],["E4","12:00","13:00"]],
     "description": "equal finish times, unsorted input", "expect": {"count": 2}},
    {"id": "T1-B7", "category": "boundary", "type": "large_vs_dp", "n": 100000, "seed": 13,
     "description": "100,000 requests: EFT = DP optimum", "expect": {"all_equal": true}},
    {"id": "T1-F1", "category": "failure", "type": "eft", "requests": [["E1","11:00","10:00"]],
     "description": "finish before start", "expect": {"error": "ValueError"}},
    {"id": "T1-F2", "category": "failure", "type": "eft", "requests": [["E2","10:00","10:00"]],
     "description": "zero-length request", "expect": {"error": "ValueError"}},
    {"id": "T1-F3", "category": "failure", "type": "eft", "requests": [["R1","09:00","10:00"],["R1","11:00","12:00"]],
     "description": "duplicate request id", "expect": {"error": "ValueError"}}
  ]
}
