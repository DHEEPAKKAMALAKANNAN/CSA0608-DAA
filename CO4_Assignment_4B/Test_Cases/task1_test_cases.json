{"task": "Word Wrap DP (document-layout engine)",
 "cases": [
  {"id": "T1-N1", "type": "file", "width": 21, "description": "layout text, W = 21: optimum 66, 7 lines, = exhaustive", "expect": {"penalty": 66, "lines": 7}},
  {"id": "T1-N2", "type": "report", "width": 21, "description": "every line <= W, words in order, penalties re-sum to total", "expect": {"valid": true}},
  {"id": "T1-S1", "type": "greedy_gap", "width": 21, "description": "DP beats greedy first-fit at W = 21 (66 < 78)", "expect": {"dp": 66, "greedy": 78}},
  {"id": "T1-V1", "type": "random_vs_exhaustive", "trials": 300, "n_max": 12, "seed": 42, "description": "300 random texts: DP = exhaustive 2^(n-1) optimum", "expect": {"all_equal": true}},
  {"id": "T1-R1", "type": "file", "width": 18, "description": "requirement change W = 18 -> penalty 27", "expect": {"penalty": 27, "lines": 7}},
  {"id": "T1-R2", "type": "file", "width": 26, "description": "requirement change W = 26 -> penalty 9", "expect": {"penalty": 9, "lines": 5}},
  {"id": "T1-R3", "type": "file", "width": 30, "description": "requirement change W = 30 -> penalty 24", "expect": {"penalty": 24, "lines": 5}},
  {"id": "T1-B1", "type": "text", "text": "an optimisation step", "width": 12, "description": "word of exactly W characters fits with s = 0", "expect": {"penalty": 100, "lines": 3}},
  {"id": "T1-B2", "type": "text", "text": "", "width": 10, "description": "empty text -> 0 lines, penalty 0", "expect": {"penalty": 0, "lines": 0}},
  {"id": "T1-B3", "type": "text", "text": "routing", "width": 10, "description": "single word -> final line only, penalty 0", "expect": {"penalty": 0, "lines": 1}},
  {"id": "T1-B4", "type": "text", "text": "a b c", "width": 10, "description": "everything on the final line is free", "expect": {"penalty": 0, "lines": 1}},
  {"id": "T1-B5", "type": "text", "text": "aa bb cc dd", "width": 2, "description": "W = longest word: one word per line", "expect": {"penalty": 0, "lines": 4}},
  {"id": "T1-F1", "type": "error", "text": "tiny enormousword ok", "width": 8, "description": "word longer than W is rejected", "expect": {"error": "LayoutError"}},
  {"id": "T1-F2", "type": "error", "text": "a b", "width": 0, "description": "W = 0 is rejected", "expect": {"error": "ValueError"}},
  {"id": "T1-F3", "type": "error", "text": "a b", "width": "20", "description": "non-integer width is rejected", "expect": {"error": "ValueError"}}
 ]}
