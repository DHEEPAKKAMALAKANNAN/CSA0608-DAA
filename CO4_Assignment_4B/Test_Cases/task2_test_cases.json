{"task": "Greedy (fractional) vs DP (0/1) knapsack",
 "cases": [
  {"id": "T2-N1", "type": "fractional_file", "file": "normal_case.json", "description": "normal case: fractional greedy 273 = unit-split DP reference", "expect": {"value": 273}},
  {"id": "T2-N2", "type": "dp_file", "file": "normal_case.json", "description": "normal case: 0/1 DP optimum 263 (N1+N2+N4+N5) = brute force", "expect": {"value": 263, "items": ["N1", "N2", "N4", "N5"]}},
  {"id": "T2-S1", "type": "counterexample", "file": "counterexample.json", "description": "counter-example: GreedyResult 153 != DPOptimum 192", "expect": {"greedy": 153, "dp": 192}},
  {"id": "T2-S2", "type": "blocking", "file": "counterexample.json", "description": "first blocking commitment = step 1 (C1)", "expect": {"step": 1, "item": "C1"}},
  {"id": "T2-V1", "type": "random_dp_vs_brute", "trials": 300, "n": 10, "seed": 42, "description": "300 random instances: DP = 2^n brute force; chosen items re-sum", "expect": {"all_ok": true}},
  {"id": "T2-V2", "type": "random_fractional_bound", "trials": 300, "n": 10, "seed": 43, "description": "fractional >= DP >= greedy-0/1; best-of-two >= OPT/2", "expect": {"all_ok": true}},
  {"id": "T2-V3", "type": "random_1d", "trials": 200, "n": 12, "seed": 44, "description": "one-row DP value = full-table DP value", "expect": {"all_ok": true}},
  {"id": "T2-R1", "type": "adversarial", "description": "adversarial: ratio greedy 2 vs OPT 1000; best-of-two recovers 1000", "expect": {"greedy": 2, "best_of_two": 1000}},
  {"id": "T2-B1", "type": "values", "items": [], "capacity": 10, "description": "no items -> value 0 for all solutions", "expect": {"fractional": 0, "dp": 0}},
  {"id": "T2-B2", "type": "values", "items": [["A", 5, 10]], "capacity": 0, "description": "capacity 0 -> nothing loaded", "expect": {"fractional": 0, "dp": 0}},
  {"id": "T2-B3", "type": "values", "items": [["A", 5, 10], ["B", 4, 8]], "capacity": 9, "description": "items exactly fill W (fits test uses <=)", "expect": {"fractional": 18, "dp": 18}},
  {"id": "T2-B4", "type": "values", "items": [["A", 12, 30]], "capacity": 10, "description": "single item heavier than W: fraction 10/12 vs nothing", "expect": {"fractional": 25, "dp": 0}},
  {"id": "T2-F1", "type": "error", "items": [["A", 0, 5]], "capacity": 10, "description": "zero weight rejected", "expect": {"error": "ValueError"}},
  {"id": "T2-F2", "type": "error", "items": [["A", 3, 5]], "capacity": -1, "description": "negative capacity rejected", "expect": {"error": "ValueError"}},
  {"id": "T2-F3", "type": "error", "items": [["A", 3, 5], ["A", 4, 6]], "capacity": 10, "description": "duplicate item id rejected", "expect": {"error": "ValueError"}}
 ]}
