{
  "task": "Task 2 - Greedy knapsack (relief-truck loading) and greedy coin change",
  "id_scheme": "G = given in the task statement, S = student-designed, B = boundary, F = failure / invalid input",
  "cases": [
    {"id": "T2-G1", "category": "given", "type": "fractional_file", "file": "given_G1_relief_supplies.csv", "capacity": 1000,
     "description": "divisible supplies, W = 1000 kg (sort and heap versions)", "expect": {"value": 5670}},
    {"id": "T2-G2", "category": "given", "type": "zero_one", "items": [["A",10,60],["B",20,100],["C",30,120]], "capacity": 50,
     "description": "textbook 0/1 instance: greedy fails", "expect": {"greedy_density": 160, "optimum": 220, "fractional": 240}},
    {"id": "T2-G3", "category": "given", "type": "zero_one_file", "file": "given_G3_relief_equipment.csv", "capacity": 1000,
     "description": "indivisible equipment: greedy leaves the generator behind",
     "expect": {"greedy_density": 1975, "greedy_value": 3300, "optimum": 3475}},
    {"id": "T2-G4", "category": "given", "type": "coins", "coins": [1,2,5,10,20,50,100,200,500], "amount": 289,
     "description": "Indian rupee system, Rs 289", "expect": {"greedy": 7, "optimum": 7}},
    {"id": "T2-G5", "category": "given", "type": "coins", "coins": [1,3,4], "amount": 6,
     "description": "non-canonical system {1, 3, 4}", "expect": {"greedy": 3, "optimum": 2}},
    {"id": "T2-S1", "category": "student", "type": "random_fractional", "trials": 200, "n": 30, "seed": 21,
     "description": "sort = heap value; fractional >= 0/1 optimum (upper bound)", "expect": {"all_ok": true}},
    {"id": "T2-S2", "category": "student", "type": "random_dp_vs_bruteforce", "trials": 200, "n": 12, "seed": 22,
     "description": "0/1 DP = brute force on 200 random instances", "expect": {"all_ok": true}},
    {"id": "T2-S3", "category": "student", "type": "half_approx", "trials": 500, "n": 12, "seed": 23,
     "items": [["small",1,2],["big",100,100]], "capacity": 100,
     "description": "max(greedy, best single) >= OPT/2; pathological case fixed", "expect": {"pathological": 100, "all_ok": true}},
    {"id": "T2-S4", "category": "student", "type": "canonical",
     "systems": {"1 10 25": 30, "1 7 10": 14, "1 3 6 12 24 30": 48, "1 2 5 10 20 50 100 200 500": null, "1 5 10 25": null},
     "description": "smallest counter-example of five coin systems", "expect": {"all_ok": true}},
    {"id": "T2-B1", "category": "boundary", "type": "fractional", "items": [["x",10,50]], "capacity": 0,
     "description": "zero capacity", "expect": {"value": 0}},
    {"id": "T2-B2", "category": "boundary", "type": "fractional", "items": [], "capacity": 100,
     "description": "no items", "expect": {"value": 0}},
    {"id": "T2-B3", "category": "boundary", "type": "fractional", "items": [["a",10,30],["b",20,50]], "capacity": 1000,
     "description": "everything fits", "expect": {"value": 80}},
    {"id": "T2-B4", "category": "boundary", "type": "fractional", "items": [["big",400,1000]], "capacity": 100,
     "description": "single item larger than the truck", "expect": {"value": 250}},
    {"id": "T2-B5", "category": "boundary", "type": "coins", "coins": [1,3,4], "amount": 0,
     "description": "amount 0", "expect": {"greedy": 0, "optimum": 0}},
    {"id": "T2-B6", "category": "boundary", "type": "fractional", "items": [["p",10,40],["q",20,80],["r",30,120]], "capacity": 25,
     "description": "all densities equal (ties)", "expect": {"value": 100}},
    {"id": "T2-F1", "category": "failure", "type": "coins", "coins": [2,5], "amount": 6,
     "description": "greedy gets stuck although 2+2+2 exists", "expect": {"greedy": null, "optimum": 3}},
    {"id": "T2-F2", "category": "failure", "type": "coins", "coins": [2,5], "amount": 3,
     "description": "amount that cannot be paid at all", "expect": {"greedy": null, "optimum": null}},
    {"id": "T2-F3", "category": "failure", "type": "fractional", "items": [["bad",-5,10]], "capacity": 100,
     "description": "negative weight", "expect": {"error": "ValueError"}},
    {"id": "T2-F4", "category": "failure", "type": "fractional", "items": [["x",5,10]], "capacity": -1,
     "description": "negative capacity", "expect": {"error": "ValueError"}},
    {"id": "T2-F5", "category": "failure", "type": "coins", "coins": [0,1], "amount": 5,
     "description": "coin of value 0", "expect": {"error": "ValueError"}}
  ]
}
