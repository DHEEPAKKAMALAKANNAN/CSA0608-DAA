{
  "task": "Task 6 - Day-4 Design Challenge: debug, optimise and validate the ambulance route service",
  "units": "small networks: minutes; generated city grids: seconds",
  "networks": {
    "G1": {"description": "given road network of Task 5 (H = City Hospital)",
           "roads": [["H","A",4,true],["H","B",2,true],["B","A",1,true],["A","C",5,true],["B","C",8,true],
                     ["B","D",10,true],["C","D",3,true],["C","E",2,true],["D","F",6,true],["E","F",8,true],
                     ["F","G",2,false],["G","E",3,false],["D","G",9,false]]},
    "G1Z": {"description": "G1 plus junction Z that only has an outgoing road (Z -> H)",
            "roads": [["H","A",4,true],["H","B",2,true],["B","A",1,true],["A","C",5,true],["B","C",8,true],
                      ["B","D",10,true],["C","D",3,true],["C","E",2,true],["D","F",6,true],["E","F",8,true],
                      ["F","G",2,false],["G","E",3,false],["D","G",9,false],["Z","H",5,false]]},
    "RI": {"description": "repeated improvement: x is improved three times, t twice; Z is isolated",
           "junctions": ["s","a1","a2","a3","x","y","t","Z"],
           "roads": [["s","a1",1,false],["s","a2",2,false],["s","a3",3,false],["a1","x",10,false],
                     ["a2","x",8,false],["a3","x",6,false],["x","y",1,false],["y","t",1,false],["s","t",50,false]]},
    "ZERO": {"description": "zero-time link roads", "roads": [["P","Q",0,false],["Q","R",0,false],["P","R",1,false]]},
    "ONE": {"description": "a single junction, no roads", "junctions": ["H"], "roads": []},
    "NEG": {"description": "invalid network: negative initial travel time", "roads": [["H","A",-2,true],["A","B",3,true]]},
    "GRID30": {"grid": [30, 30, 42], "description": "30 x 30 city grid (900 junctions)"},
    "GRID100K": {"grid": [250, 400, 42], "description": "250 x 400 city grid (100,000 junctions)"}
  },
  "cases": [
    {"id": "T6-G1", "category": "given", "network": "G1", "query": ["H","G"],
     "description": "fastest route H -> G", "expect": {"time": 19, "path": ["H","B","A","C","D","F","G"]}},
    {"id": "T6-G2", "category": "given", "network": "G1", "query": ["H","A"],
     "description": "direct road H-A (4) is slower than H-B-A (3)", "expect": {"time": 3, "path": ["H","B","A"]}},
    {"id": "T6-G3", "category": "given", "network": "G1", "query": ["H","D"],
     "updates": [["C","D",-1],["D","C",-1]],
     "description": "feed closes C-D in both directions (-1 = closed)", "expect": {"time": 12, "path": ["H","B","D"]}},
    {"id": "T6-G4", "category": "given", "network": "G1", "query": ["H","E"],
     "updates": [["C","E",9],["E","C",9]],
     "description": "feed re-times C-E to 9 min", "expect": {"time": 17, "path": ["H","B","A","C","E"]}},
    {"id": "T6-S1", "category": "student", "network": "RI", "query": ["s","Z"],
     "description": "unreachable target, every junction must be expanded at most once (7 reachable)",
     "expect": {"unreachable": true}, "max_expansions": 7},
    {"id": "T6-S2", "category": "student", "network": "G1", "query": ["H","H"],
     "description": "source = destination", "expect": {"time": 0, "path": ["H"]}},
    {"id": "T6-S3", "category": "student", "network": "ZERO", "query": ["P","R"],
     "description": "zero-time roads are legal", "expect": {"time": 0, "path": ["P","Q","R"]}},
    {"id": "T6-S4", "category": "student", "network": "G1", "query": ["H","D"],
     "updates": [["C","D",-1],["C","D",3]],
     "description": "a road closed and re-opened in the same feed", "expect": {"time": 11, "path": ["H","B","A","C","D"]}},
    {"id": "T6-S5", "category": "student", "network": "GRID30", "query": [0, 899],
     "description": "work bounds on 900 junctions: expansions <= V, road scans <= E",
     "expect": {"reference": true}, "max_expansions": "V", "max_road_scans": "E"},
    {"id": "T6-S6", "category": "student", "network": "GRID30", "query": [0, 899], "feed": true, "method": "astar",
     "fixed_only": true, "description": "A* after a daily feed returns the reference (Dijkstra) time",
     "expect": {"reference": true}},
    {"id": "T6-B1", "category": "boundary", "network": "ONE", "query": ["H","H"],
     "description": "one-junction network", "expect": {"time": 0, "path": ["H"]}},
    {"id": "T6-B2", "category": "boundary", "network": "G1Z", "query": ["H","Z"],
     "description": "junction with no incoming road", "expect": {"unreachable": true}},
    {"id": "T6-B3", "category": "boundary", "network": "G1", "query": ["H","Q"],
     "description": "query for a junction that does not exist", "expect": {"error": "ValueError"}},
    {"id": "T6-B4", "category": "boundary", "network": "G1", "query": ["H","G"], "updates": [["H","G",5]],
     "description": "feed record for a road that does not exist", "expect": {"error": "ValueError"}},
    {"id": "T6-F1", "category": "failure", "network": "G1", "query": ["H","D"], "updates": [["B","D",-5]],
     "description": "negative travel time that is not the closure code", "expect": {"error": "ValueError"}},
    {"id": "T6-F2", "category": "failure", "network": "G1", "query": ["H","D"],
     "updates": [["B","D",-1],["C","D",-1],["F","D",-1]],
     "description": "every road into D closed", "expect": {"unreachable": true}},
    {"id": "T6-F3", "category": "failure", "network": "NEG", "query": ["H","B"],
     "description": "network with a negative initial travel time", "expect": {"error": "ValueError"}},
    {"id": "T6-L1", "category": "scale", "network": "GRID100K", "query": [0, 99999], "feed": true,
     "fixed_only": true, "description": "100,000 junctions + nightly feed: Dijkstra and A* equal the reference",
     "expect": {"reference": true}, "method": "both", "max_seconds": 30}
  ]
}
