{
  "task": "Last-mile delivery route optimisation - TSP by Held-Karp dynamic programming",
  "id_scheme": "N normal, S student-designed, B boundary, F failure / invalid input, V validation against an independent reference, R requirement change",
  "cases": [
    {"id": "T6-N1", "type": "file_cost", "file": "delivery_costs.csv",
     "description": "hub + 6 locations: minimum travel cost", "expect": {"cost": 123}},
    {"id": "T6-N2", "type": "file_route", "file": "delivery_costs.csv",
     "description": "route is a Hamiltonian tour; re-added cost = reported",
     "expect": {"route_one_of": [["Hub", "E", "D", "B", "F", "A", "C", "Hub"], ["Hub", "C", "A", "F", "B", "D", "E", "Hub"]]}},
    {"id": "T6-V1", "type": "file_vs_exhaustive", "file": "validation_hub4.csv",
     "description": "hub + 4 locations: DP = exhaustive over 24 routes", "expect": {"cost": 97, "routes": 24}},
    {"id": "T6-V2", "type": "random_vs_exhaustive", "n_values": [1, 2, 3, 4, 5, 6, 7], "trials": 15, "symmetric": true, "seed": 61,
     "description": "random symmetric instances n=1..7: DP = brute force", "expect": {"all_ok": true}},
    {"id": "T6-V3", "type": "random_vs_exhaustive", "n_values": [1, 2, 3, 4, 5, 6, 7, 8], "trials": 4, "symmetric": false, "seed": 62,
     "description": "random asymmetric instances n=1..8: DP = brute force", "expect": {"all_ok": true}},
    {"id": "T6-S1", "type": "file_vs_exhaustive", "file": "asymmetric_hub5.csv",
     "description": "one-way streets (asymmetric): unique optimum found", "expect": {"cost": 116, "routes": 120}},
    {"id": "T6-S2", "type": "state_count", "n_values": [1, 2, 3, 4, 6, 8, 10],
     "description": "states = n*2^(n-1), transitions = n(n-1)2^(n-2)+n", "expect": {"all_ok": true}},
    {"id": "T6-S3", "type": "relabel", "file": "delivery_costs.csv", "permutation": [4, 6, 1, 5, 3, 2],
     "description": "renumbering the locations does not change the optimum", "expect": {"cost": 123}},
    {"id": "T6-B1", "type": "matrix", "matrix": [[0, 7], [9, 0]],
     "description": "single delivery location: Hub -> 1 -> Hub", "expect": {"cost": 16, "route": [0, 1, 0]}},
    {"id": "T6-B2", "type": "matrix", "matrix": [[0, 4, 6], [5, 0, 3], [8, 2, 0]],
     "description": "two locations, asymmetric: picks cheaper direction", "expect": {"cost": 13, "route": [0, 2, 1, 0]}},
    {"id": "T6-B3", "type": "matrix", "matrix": [[0, 5, 5, 5], [5, 0, 5, 5], [5, 5, 0, 5], [5, 5, 5, 0]],
     "description": "all costs equal (every tour ties): cost 4*5", "expect": {"cost": 20}},
    {"id": "T6-B4", "type": "file_cost", "file": "unreachable_hub3.csv",
     "description": "location without return road: no feasible tour (inf)", "expect": {"cost": "inf"}},
    {"id": "T6-F1", "type": "invalid", "matrix": [[0, 1, 2], [1, 0]],
     "description": "non-square matrix rejected", "expect": {"error": "InvalidCostMatrix"}},
    {"id": "T6-F2", "type": "invalid", "matrix": [[0, -3], [3, 0]],
     "description": "negative travel cost rejected", "expect": {"error": "InvalidCostMatrix"}},
    {"id": "T6-F3", "type": "invalid", "matrix": [[5, 1], [1, 0]],
     "description": "non-zero diagonal rejected", "expect": {"error": "InvalidCostMatrix"}},
    {"id": "T6-F4", "type": "invalid", "matrix": [[0]],
     "description": "hub only (no delivery location) rejected", "expect": {"error": "InvalidCostMatrix"}},
    {"id": "T6-R1", "type": "add_location", "file": "delivery_costs.csv", "new_costs": [22, 30, 9, 40, 25, 44, 18],
     "description": "new location G: 448 states, DP = brute force (5040 routes)", "expect": {"states": 448}}
  ]
}
