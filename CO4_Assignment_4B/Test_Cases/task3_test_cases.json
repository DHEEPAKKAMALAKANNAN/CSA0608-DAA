{
  "task": "Task 3 - Huffman coding of SOC event logs",
  "id_scheme": "G = given in the task statement, S = student-designed, B = boundary, F = failure / invalid input",
  "cases": [
    {"id": "T3-G1", "category": "given", "type": "huffman", "freqs": {"L": 45, "F": 13, "W": 12, "D": 16, "S": 9, "M": 5},
     "description": "SOC event frequencies (thousands)",
     "expect": {"total_bits": 224, "lengths": {"L": 1, "W": 3, "F": 3, "D": 3, "M": 4, "S": 4}}},
    {"id": "T3-G2", "category": "given", "type": "ties", "freqs": {"a": 1, "b": 1, "c": 2, "d": 2},
     "description": "ties: fifo and lifo give different trees, same cost",
     "expect": {"fifo_cost": 12, "lifo_cost": 12, "fifo_max_len": 2, "lifo_max_len": 3}},
    {"id": "T3-S1", "category": "student", "type": "round_trip", "freqs": {"L": 45, "F": 13, "W": 12, "D": 16, "S": 9, "M": 5},
     "message": "LLFDLWLMSLDL", "description": "encode then decode a message", "expect": {"bits": 26}},
    {"id": "T3-S2", "category": "student", "type": "random_equal_cost", "trials": 200, "m": 40, "seed": 31,
     "description": "heap = naive O(m^2) = two-queue cost; prefix-free; round trip", "expect": {"all_ok": true}},
    {"id": "T3-S3", "category": "student", "type": "random_bounds", "trials": 200, "m": 25, "seed": 32,
     "description": "Kraft sum = 1 and H <= L < H + 1", "expect": {"all_ok": true}},
    {"id": "T3-S4", "category": "student", "type": "soc_stream", "n": 20000, "seed": 33,
     "description": "synthetic SOC stream: beats 4-bit fixed code, round trip exact", "expect": {"all_ok": true}},
    {"id": "T3-B1", "category": "boundary", "type": "huffman", "freqs": {"L": 7},
     "description": "single symbol gets the 1-bit code 0", "expect": {"total_bits": 7, "lengths": {"L": 1}}},
    {"id": "T3-B2", "category": "boundary", "type": "huffman", "freqs": {"L": 99, "M": 1},
     "description": "two symbols", "expect": {"total_bits": 100, "lengths": {"L": 1, "M": 1}}},
    {"id": "T3-B3", "category": "boundary", "type": "huffman",
     "freqs": {"A": 10, "B": 10, "C": 10, "D": 10, "E": 10, "F": 10, "G": 10, "H": 10},
     "description": "8 equal frequencies = fixed 3-bit code", "expect": {"total_bits": 240}},
    {"id": "T3-B4", "category": "boundary", "type": "huffman",
     "freqs": {"A": 1, "B": 1, "C": 2, "D": 3, "E": 5, "F": 8, "G": 13, "H": 21},
     "description": "Fibonacci frequencies: depth m - 1", "expect": {"max_length": 7}},
    {"id": "T3-F1", "category": "failure", "type": "huffman", "freqs": {},
     "description": "empty alphabet", "expect": {"error": "ValueError"}},
    {"id": "T3-F2", "category": "failure", "type": "decode", "freqs": {"L": 45, "F": 13, "W": 12, "D": 16, "S": 9, "M": 5},
     "bits": "0110", "description": "truncated bitstream", "expect": {"error": "ValueError"}},
    {"id": "T3-F3", "category": "failure", "type": "encode", "freqs": {"L": 45, "F": 13, "W": 12, "D": 16, "S": 9, "M": 5},
     "message": "LX", "description": "symbol not in the code table", "expect": {"error": "ValueError"}},
    {"id": "T3-F4", "category": "failure", "type": "huffman", "freqs": {"L": 5, "M": 0},
     "description": "zero frequency", "expect": {"error": "ValueError"}},
    {"id": "T3-F5", "category": "failure", "type": "decode", "freqs": {"L": 45, "F": 13, "W": 12, "D": 16, "S": 9, "M": 5},
     "bits": "0120", "description": "invalid character in bitstream", "expect": {"error": "ValueError"}}
  ]
}
